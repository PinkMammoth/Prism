# Prism scheduler (supercronic; the ONLY scheduling authority on this host).
# Profile-gated: ExecCondition skips the unit (no restart loop) unless the resolved
# runtime profile enables process 'scheduler'; the program re-checks and exits 78 if it is not.
[Unit]
Description=Prism scheduler (supercronic; the ONLY scheduling authority on this host)
PartOf=prism.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=prism
Group=prism
WorkingDirectory=/opt/prism/current
EnvironmentFile=/etc/prism/prism.env
EnvironmentFile=-/etc/prism/secrets.env
Environment=PATH=/opt/prism/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/opt/prism/current/.venv/bin/market ops profile --process scheduler --condition
ExecStart=/opt/prism/current/deploy/vps/run_scheduler.sh
Restart=always
RestartSec=10
RestartPreventExitStatus=78
# supercronic waits for a running job on SIGTERM; jobs are idempotent and lock-serialised.
TimeoutStopSec=900
KillMode=mixed
MemoryMax=4G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=prism.target
