# Prism context gateway HTTP/MCP ingress (never opens DuckDB).
# Profile-gated: ExecCondition skips the unit (no restart loop) unless the resolved
# runtime profile enables process 'context_gateway'; the program re-checks and exits 78 if it is not.
[Unit]
Description=Prism context gateway HTTP/MCP ingress (never opens DuckDB)
PartOf=prism.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=prism
Group=prism
WorkingDirectory=/opt/prism/current
EnvironmentFile=/etc/prism/prism.env
EnvironmentFile=-/etc/prism/secrets.env
Environment=PATH=/opt/prism/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/opt/prism/current/.venv/bin/market ops profile --process context_gateway --condition
ExecStart=/opt/prism/current/.venv/bin/python -m market_signal.context.gateway.launch
Restart=always
RestartSec=10
RestartPreventExitStatus=78
# Not in prism_autotrader_lab_v1: Work submissions stay on Railway until a deliberate move.
TimeoutStopSec=30
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=prism.target
