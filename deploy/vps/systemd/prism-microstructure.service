# Prism Hyperliquid microstructure collector (public data -> spool; never opens DuckDB).
# Profile-gated: ExecCondition skips the unit (no restart loop) unless the resolved
# runtime profile enables process 'microstructure_collector'; the program re-checks and exits 78 if it is not.
[Unit]
Description=Prism Hyperliquid microstructure collector (public data -> spool; never opens DuckDB)
PartOf=prism.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=prism
Group=prism
WorkingDirectory=/opt/prism/current
EnvironmentFile=/etc/prism/prism.env
EnvironmentFile=-/etc/prism/secrets.env
Environment=PATH=/opt/prism/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/opt/prism/current/.venv/bin/market ops profile --process microstructure_collector --condition
ExecStart=/opt/prism/current/.venv/bin/market microstructure collect
Restart=always
RestartSec=10
RestartPreventExitStatus=78
# A restart loses only the open minute (recorded PARTIAL/GAP); deploys restart it only on request.
TimeoutStopSec=30
MemoryMax=768M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=prism.target
