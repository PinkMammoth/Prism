# Prism context gateway ingest worker (authoritative DB writer under the runtime lock).
# Profile-gated: ExecCondition skips the unit (no restart loop) unless the resolved
# runtime profile enables process 'context_ingest'; the program re-checks and exits 78 if it is not.
[Unit]
Description=Prism context gateway ingest worker (authoritative DB writer under the runtime lock)
PartOf=prism.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=prism
Group=prism
WorkingDirectory=/opt/prism/current
EnvironmentFile=/etc/prism/prism.env
EnvironmentFile=-/etc/prism/secrets.env
Environment=PATH=/opt/prism/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/opt/prism/current/.venv/bin/market ops profile --process context_ingest --condition
ExecStart=/opt/prism/current/.venv/bin/python -m market_signal.context.gateway.worker
Restart=always
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=120
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=prism.target
