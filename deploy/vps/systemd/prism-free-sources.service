# Prism free public event-source collector (spool only; never opens DuckDB).
# Profile-gated: ExecCondition skips the unit (no restart loop) unless the resolved
# runtime profile enables process 'free_source_collector'; the program re-checks and exits 78 if it is not.
[Unit]
Description=Prism free public event-source collector (spool only; never opens DuckDB)
PartOf=prism.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=prism
Group=prism
WorkingDirectory=/opt/prism/current
EnvironmentFile=/etc/prism/prism.env
EnvironmentFile=-/etc/prism/secrets.env
Environment=PATH=/opt/prism/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/opt/prism/current/.venv/bin/market ops profile --process free_source_collector --condition
ExecStart=/opt/prism/current/.venv/bin/python -m market_signal.context.free_sources.collector
Restart=always
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=30
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=prism.target
