# Prism Dynamic Universe Tier 0 radar (ranking ledger). GATED: no profile enables it yet.
# Profile-gated: ExecCondition skips the unit (no restart loop) unless the resolved
# runtime profile enables process 'universe_radar'; the program re-checks and exits 78 if it is not.
[Unit]
Description=Prism Dynamic Universe radar (gated)
PartOf=prism.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=prism
Group=prism
WorkingDirectory=/opt/prism/current
EnvironmentFile=/etc/prism/prism.env
EnvironmentFile=-/etc/prism/secrets.env
Environment=PATH=/opt/prism/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/opt/prism/current/.venv/bin/market ops profile --process universe_radar --condition
ExecStart=/opt/prism/current/.venv/bin/python -m market_signal.universe.worker
Restart=always
RestartSec=10
RestartPreventExitStatus=78
# Activation needs VPS validation and a new profile version; until then ExecCondition skips it.
TimeoutStopSec=120
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=prism.target
