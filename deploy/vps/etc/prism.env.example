# /etc/prism/prism.env (root:prism 0640). Non-secret runtime identity + paths. Secrets (Telegram,
# FRED, OAuth, heartbeat URL) go in /etc/prism/secrets.env (root:prism 0640), never in Git.
# docs/RUNTIME_PROFILE_SPLIT_AND_VPS_LAB.md: the three settings below are validated together;
# any contradiction refuses to start every unit (exit 78).

PRISM_PROFILE=autotrader_lab
PRISM_DEPLOYMENT_TARGET=vps
# none      : passive public-data collectors only (spool files). PRISM_RUNTIME_ROLE=scratch.
# rehearsal : + ingest/data jobs into a rehearsal DB claimed by the rehearsal runtime id.
#             Never paper execution, notifications, heartbeat or external ingress.
# full      : the lab's single authoritative runtime (only after an approved cutover).
PRISM_AUTHORITY=none
PRISM_RUNTIME_ROLE=scratch
# rehearsal: PRISM_RUNTIME_ROLE=authoritative + PRISM_RUNTIME_ID=vps-prism-autotrader-lab-rehearsal
# full:      PRISM_RUNTIME_ROLE=authoritative + PRISM_RUNTIME_ID=vps-prism-autotrader-lab
#PRISM_RUNTIME_ID=

PRISM_HOME=/opt/prism/current
PRISM_DB_PATH=/data/prism.duckdb
PRISM_RAW_DIR=/data/raw
PRISM_BACKUP_DIR=/data/backups
PRISM_LOG_DIR=/data/logs
PRISM_STATE_DIR=/data/state
PYTHONUNBUFFERED=1
TZ=UTC
