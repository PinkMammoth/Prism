# /etc/prism-research-backup/backup.env  prism-research-backup:prism-research-backup 0600.
# Locations only; the secrets live in the two files named here and are never printed.
RESTIC_REPOSITORY=rclone:prism-gdrive:Prism/backups/research/restic
RESTIC_PASSWORD_FILE=/etc/prism-research-backup/restic-password
RCLONE_CONFIG=/etc/prism-research-backup/rclone.conf
# Long-lived OAuth refresh token is in rclone.conf (drive.file scope: only files rclone
# created). Independent recovery = user's own restic key + re-authorizing rclone on any
# machine with the same Google account; see docs/GOOGLE_DRIVE_BACKUP_RECOVERY.md.
