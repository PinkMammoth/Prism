# Namespaced units; never replace existing prism-*.service lab units.
[Unit]
Description=Prism OVH research process %i
PartOf=prism-research.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prism-research
Group=prism-research
Slice=prism-research.slice
WorkingDirectory=/opt/prism/research/current
EnvironmentFile=/etc/prism-research/runtime.env
EnvironmentFile=-/etc/prism-research/secrets.env
Environment=PATH=/opt/prism/research/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/opt/prism/research/current/.venv/bin/market ops profile --process %i --condition
ExecStart=/opt/prism/research/current/deploy/consolidated/run_research_process.sh %i
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=900
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/prism-research
ReadOnlyPaths=/var/lib/prism-research/import
InaccessiblePaths=/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=prism-research.target
