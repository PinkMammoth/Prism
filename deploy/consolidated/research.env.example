# PREPARED ONLY. Install separately from /etc/prism/prism.env; do not start lab/research.
# root:prism-research 0640; secret values belong in /etc/prism-research/secrets.env.
PRISM_PROFILE=research_vps
PRISM_DEPLOYMENT_TARGET=vps
PRISM_AUTHORITY=none
PRISM_RUNTIME_ROLE=reader
# Full cutover: authority=full, role=authoritative, runtime_id=vps-prism-research.
# Rehearsal copy: authority=rehearsal, runtime_id=vps-prism-research-rehearsal.
# Neither can write a DB still claimed by railway-prism-runtime.
PRISM_RUNTIME_ID=
PRISM_HOME=/opt/prism/research/current
PRISM_DB_PATH=/var/lib/prism-research/import/prism.duckdb
PRISM_RAW_DIR=/var/lib/prism-research/raw
PRISM_RESULTS_DIR=/var/lib/prism-research/results
PRISM_BACKUP_DIR=/var/lib/prism-research/backups
PRISM_LOG_DIR=/var/lib/prism-research/logs
PRISM_STATE_DIR=/var/lib/prism-research/state
PRISM_MICRO_DIR=/var/lib/prism-research/microstructure
PRISM_CONTEXT_GATEWAY_DIR=/var/lib/prism-research/context_gateway
PRISM_FREE_SOURCES_DIR=/var/lib/prism-research/free_event_sources
PRISM_MICROSTRUCTURE=off
PRISM_FREE_SOURCES=off
PRISM_CONTEXT_GATEWAY=off
PRISM_NIMBLE_RUNTIME=off
PRISM_UNIVERSE_STAGE=off
PRISM_CONTEXT_GATEWAY_HOST=127.0.0.1
PORT=8787
PRISM_CONTEXT_TRUSTED_PROXIES=127.0.0.1
# Set only after approved stable hostname and OAuth audience cutover.
#PRISM_CONTEXT_GATEWAY_URL=https://OWNED_PRISM_HOSTNAME
PYTHONUNBUFFERED=1
TZ=UTC
