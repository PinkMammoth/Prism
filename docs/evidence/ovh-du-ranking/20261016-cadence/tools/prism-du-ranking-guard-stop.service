[Unit]
Description=Preserve history and restore v1 if the continuing ranking safety guard fails

[Service]
Type=oneshot
ExecStart=/bin/systemctl stop prism-universe.service
ExecStart=/opt/prism/current/.venv/bin/python /data/validation/du-ranking-cadence/attempt-2/tools/ranking_watch.py --root /data/validation/du-ranking-cadence/attempt-2/post-window-guard --rollback-only
TimeoutStartSec=420
MemoryMax=512M
Nice=19
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/data /etc/prism
InaccessiblePaths=/var/lib/prism-research /etc/prism-research-backup
