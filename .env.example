# Copy to .env and fill in. All keys are FREE. Never commit .env.

# Tiingo (equities/ETFs EOD) — https://www.tiingo.com (free Starter tier)
TIINGO_API_KEY=

# FRED / ALFRED (macro, point-in-time vintages) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIA (energy, optional) — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email (no key)
SEC_USER_AGENT="Prism personal research your.name@example.com"

# Stooq (optional fallback; key obtained via CAPTCHA on stooq.com)
STOOQ_API_KEY=

# Telegram daily brief (optional, free): create a bot with @BotFather, paste its token,
# message the bot once, then run `uv run market telegram-setup` to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
# PRISM_DB_PATH=data/prism.duckdb
# PRISM_RAW_DIR=data/raw

# Phase 26A: opt-in information gateway. Configure values in Railway's secret UI.
# Keep off until OAuth, caller allowlist and HTTPS routing have been verified.
# PRISM_CONTEXT_GATEWAY=off
# PRISM_CONTEXT_GATEWAY_URL=https://your-gateway.up.railway.app
# PRISM_CONTEXT_OAUTH_ISSUER=https://your-tenant.auth0.com/
# PRISM_CONTEXT_OAUTH_JWKS=https://your-tenant.auth0.com/.well-known/jwks.json
# PRISM_CONTEXT_OAUTH_PRINCIPALS={"auth0|USER_ID|OAUTH_CLIENT_ID":"chatgpt_work_personal_v1"}
# Optional service tokens: multiple keys for rotation, same identity across rotation.
# PRISM_CONTEXT_GATEWAY_TOKENS={"GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS":"trusted_monitor_v1"}
# PRISM_CONTEXT_TRUSTED_PROXIES=127.0.0.1
# PRISM_CONTEXT_GATEWAY_DIR=/data/context_gateway
# PRISM_CONTEXT_INGEST_SECONDS=5
# PRISM_CONTEXT_RATE_PER_MINUTE=10
# PRISM_CONTEXT_SPOOL_MAX_BYTES=134217728
# Local test client only (never supply a secret on the command line):
# PRISM_CONTEXT_TEST_TOKEN=

# Phase 27: supervised paper worker on the authoritative runtime only.
# Remains idle until `market paper nimble register` and `create`.
# Existing v2 scheduling is preserved. This does not enable live trading.
# PRISM_NIMBLE_RUNTIME=on
